# Copy to .env and replace placeholders with local values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:replace_me@localhost:5432/norfae_intelligence_os
DISCORD_BOT_TOKEN=

GST_PERCENTAGE=16
FUEL_SURCHARGE_PERCENTAGE=30
INCOME_TAX_PERCENTAGE=4
META_SYNC_INTERVAL=300
DEFAULT_PACKAGING_COST=50
WAREHOUSE_CITY=Lahore
WAREHOUSE_PROVINCE=Punjab

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT=30
OPENROUTER_MAX_RETRIES=2

APP_ENV=development
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production requires at least 32 random bytes. Never reuse OPENROUTER_API_KEY.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
